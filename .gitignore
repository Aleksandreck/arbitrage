# Виртуальное окружение Python — не нужно в репозитории
.venv/
venv/
env/

# Кэш Python (создаётся автоматически при запуске)
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Результаты работы программы (CSV-отчёты) — не коммитим
output/
*.csv

# Секреты и локальные настройки (на будущее, когда появятся API-ключи)
.env
.env.local

# IDE и редакторы
.idea/
.vscode/
*.swp

# Файлы операционной системы
.DS_Store
Thumbs.db

# Кэш тестов
.pytest_cache/
.coverage
htmlcov/
